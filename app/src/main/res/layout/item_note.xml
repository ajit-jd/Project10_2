<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/search_bar_background"
    android:padding="10dp"
    android:layout_marginBottom="14dp">

    <TextView
        android:id="@+id/textViewNoteTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Note Title Placeholder"
        android:textColor="@color/light_text"
        android:textStyle="bold"
        android:textSize="18sp"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/imageViewThumbnail"
        android:layout_marginEnd="10dp"/>

    <TextView
        android:id="@+id/textViewNoteDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Note description goes here... and can be a bit longer to see how it wraps."
        android:textColor="@color/description_text_color"
        android:textStyle="normal"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textViewNoteTitle"
        app:layout_constraintEnd_toStartOf="@id/imageViewThumbnail"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="4dp"/>

    <ImageView
        android:id="@+id/imageViewThumbnail"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@android:drawable/ic_menu_gallery"
        android:background="@drawable/rounded_corners_background"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
